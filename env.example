# Database — copy your Supabase connection string here (the "URI" one from Project Settings → Database)
DATABASE_URL="postgresql://user:password@host:port/database"

# Resend — from your Resend account, API Keys section
RESEND_API_KEY="re_xxxxxxxxxxxx"

# JWT secrets — make these up yourself, long random strings, keep them secret
# You can generate one by typing a long random sentence with numbers and symbols
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"

# App environment
NODE_ENV="development"
PORT=3000

# Google Sign-In — from Google Cloud Console OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Supabase Storage (server-side upload/signing)
SUPABASE_URL=https://nibinafvyxdtzoumgfgk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ceremony-media
