datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- ENUMS ----------

enum StokvelType {
  ALCOHOL_BULK_POOL
  UMGALELO_ROTATING
  CEREMONY_SAVINGS
  EXISTING_STOKVEL_UPGRADE
  RECIPROCAL_GIFTING
}

enum BankingTrack {
  AFRICAN_BANK
  GOTYME_YOCO
}

enum BasketStatus {
  DRAFT
  PARKED
  MATCHED
  FULFILLED
  CANCELLED
}

enum PartnerType {
  TAVERN
  BUTCHERY
  GROCERY
  PRODUCE
}

enum ClanConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TransactionStatus {
  PENDING_APPROVAL
  CLEARED
  UNMATCHED
  FAILED
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  MISSED
  DEFERRED
}

enum CeremonyType {
  UMSEBENZI_WENKOMO
  IMIGIDI
  UMGIDI
  ULWALUKO
  WEDDING
  GENERAL_EVENT
  INTAMBO_ENKULU
  UKUKHAPHA
  UKUBUYISA
  INKOBE_ZIKA_MAMA
  UMSEBENZI_WEGQIRHA
  IMBELEKO
  INTONJANE
  UMGQUPHUZO
  UKUZILA
  UMEMBESO_UMENDISO
  UMSINDLEKO
  UMHLONYANE
  UKUPHAHLA
  INTLOMBE
}

enum PortalVisibility {
  FAMILY_PRIVATE
  CLAN_SCOPED
  PUBLIC
}

enum OfficialRole {
  CHAIRPERSON
  TREASURER
  SECRETARY
}

enum IdentityVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ---------- CORE MODELS ----------

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  firstName              String
  lastName               String
  username               String?              @unique
  passwordHash           String?
  googleId               String?              @unique
  address                String?
  age                    Int?
  phoneNumber            String?
  location               String?
  latitude               Float?
  longitude              Float?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  profileImage           String?              @db.Text
  paternalIziduko        String?
  maternalIziduko        String?
  paternalGrandmotherIziduko String?
  maternalGrandmotherIziduko String?
  pinHash                String?

  // Identity verification — the ID number is encrypted at rest (AES-256-GCM,
  // see server/services/encryptionService.js), never stored or returned in
  // plaintext. idNumberLast4 is kept unencrypted purely so the owner and
  // reviewers can reference "the ID ending in 1234" without decrypting.
  // idDocumentUrl mirrors the existing Directory practitioner idDocUrl
  // pattern (base64 inline, size-capped). profileImage doubles as the face
  // reference photo for this purpose — a future biometric/liveness provider
  // slots in against these same fields rather than needing new ones.
  idNumberEncrypted          String?                     @db.Text
  idNumberLast4              String?
  idDocumentUrl               String?                    @db.Text
  identityVerificationStatus IdentityVerificationStatus @default(UNVERIFIED)
  identitySubmittedAt         DateTime?
  identityVerifiedAt          DateTime?
  identityVerifiedById         String?
  identityRejectionReason      String?

  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  stokvelMemberships     StokvelMember[]
  organisedStokvels      Stokvel[]            @relation("StokvelOrganiser")
  officialRoles          StokvelOfficial[]
  baskets                Basket[]
  digitalPortals         DigitalPortal[]
  reciprocityEntries     ReciprocityEntry[]
  expenditureEntries     ExpenditureEntry[]
  hostedCeremonies       Ceremony[]
  preparationPlans       PreparationPlan[]
  barBookingsHosted      BarServiceBooking[]
  tourismPackages        TourismPackage[]
  otpCodes               OtpCode[]
  refreshTokens          RefreshToken[]
  notifications          Notification[]       // ✅ added
  recordedUkusokaEntries UkusokaEntry[]
  announcementsPosted    StokvelAnnouncement[]
  poolPayments            PoolPayment[]
  sentClanConnections     ClanConnection[]      @relation("ClanConnectionRequester")
  receivedClanConnections ClanConnection[]      @relation("ClanConnectionRecipient")
  sentMessages            Message[]             @relation("MessageSender")
  receivedMessages        Message[]             @relation("MessageRecipient")
  partner                 Partner?
  createdVendors          Vendor[]
  directoryVotes          DirectoryVote[]
  clanGroupId              String?
  clanGroup                ClanGroup?           @relation(fields: [clanGroupId], references: [id], onDelete: SetNull)
  createdBulkPools         BulkPool[]            @relation("BulkPoolCreator")
  stokvelPoolFundingRequests StokvelPoolFunding[] @relation("StokvelPoolFundingRequester")
  stokvelPoolFundingApprovals StokvelPoolFundingApproval[] @relation("StokvelPoolFundingApprover")
  isidukoSubmissions IsidukoSubmission[]

  @@index([clanGroupId])
}

model ClanConnection {
  id          String               @id @default(cuid())
  requesterId String
  requester   User                 @relation("ClanConnectionRequester", fields: [requesterId], references: [id])
  recipientId String
  recipient   User                 @relation("ClanConnectionRecipient", fields: [recipientId], references: [id])
  status      ClanConnectionStatus @default(PENDING)
  message     String?
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
}

// In-app text messages — only ever sendable between two users with an
// ACCEPTED ClanConnection between them (enforced in messageService.js, not
// here — this app has no DB-level FK/check constraints added post-baseline,
// same posture as every other model ensure-schema.js has extended). No
// separate "conversation" table: a thread between two people is just every
// Message where they're the sender/recipient pair, in either direction.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id])
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model UkusokaEntry {
  id              String    @id @default(cuid())
  recordedById    String
  recordedBy      User      @relation(fields: [recordedById], references: [id])
  ceremonyId      String?
  ceremony        Ceremony? @relation(fields: [ceremonyId], references: [id], onDelete: SetNull)
  initiateName    String
  giverName       String
  relationship    String?
  itemDescription String
  category        String
  dateReceived    DateTime
  createdAt       DateTime  @default(now())
}

model Practitioner {
  id           String    @id @default(cuid())
  userId       String?
  name         String
  role         String
  area         String
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  idDocUrl     String?   @db.Text
  contactInfo  String?
  confirmCount Int       @default(0)
  disputeCount Int       @default(0)
  createdAt    DateTime  @default(now())
}

model Vendor {
  id           String   @id @default(cuid())
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  name         String
  category     String
  area         String
  contactInfo  String?
  description  String?
  confirmCount Int      @default(0)
  disputeCount Int      @default(0)
  createdAt    DateTime @default(now())
}

enum DirectoryTargetType {
  PRACTITIONER
  VENDOR
}

enum DirectoryVoteType {
  CONFIRM
  DISPUTE
}

// Community trust signal, distinct from admin verification: enough CONFIRM
// votes (and few enough DISPUTEs) earns a "Community Trusted" badge without
// needing an admin, while the existing isVerified/verificationStatus fields
// stay the higher, ID-document-backed tier. One vote per user per listing —
// re-voting the same way removes it, voting the other way switches it.
model DirectoryVote {
  id         String              @id @default(cuid())
  targetType DirectoryTargetType
  targetId   String
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  voteType   DirectoryVoteType
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([targetType, targetId, userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- CLAN / IZIDUKO ----------

model ClanGroup {
  id        String   @id @default(cuid())
  clanName  String   @unique
  createdAt DateTime @default(now())

  surnameGroups SurnameSubgroup[]
  aliases       ClanAlias[]
  members       User[]
  submissions   IsidukoSubmission[]
}

model ClanAlias {
  id          String    @id @default(cuid())
  clanGroupId String
  clanGroup   ClanGroup @relation(fields: [clanGroupId], references: [id])
  aliasForm   String    @unique
}

model SurnameSubgroup {
  id          String    @id @default(cuid())
  clanGroupId String
  clanGroup   ClanGroup @relation(fields: [clanGroupId], references: [id])
  surname     String

  @@unique([clanGroupId, surname])
}


// Raw text is queued for review, never turned directly into a ClanGroup.
model IsidukoSubmission {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  typedText           String
  normalisedText      String
  nationLabel         String?
  status              String    @default("PENDING_REVIEW")
  resolvedClanGroupId String?
  resolvedClanGroup   ClanGroup? @relation(fields: [resolvedClanGroupId], references: [id], onDelete: SetNull)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([status, createdAt])
  @@index([normalisedText])
}

// ---------- STOKVEL ----------

model Stokvel {
  id                    String              @id @default(cuid())
  type                  StokvelType
  name                  String
  organiserId           String
  organiser             User                @relation("StokvelOrganiser", fields: [organiserId], references: [id])
  bankingTrack          BankingTrack
  contributionAmount    Decimal?
  contributionFrequency String?
  targetAmount          Decimal?
  targetDate            DateTime?
  ceremonyType          CeremonyType?
  rotationOrder         Json?
  currentRotationIndex  Int?                @default(0)
  requiredApprovals     Int                 @default(2)
  bereavementActive     Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  members       StokvelMember[]
  officials     StokvelOfficial[]
  contributions Contribution[]
  payouts       Payout[]
  baskets       Basket[]
  fundedBaskets Basket[] @relation("BasketFundingStokvel")
  rawBankLogs   RawBankLog[]
  groupLedger   StokvelGroupLedger?
  announcements StokvelAnnouncement[]
  poolFundings  StokvelPoolFunding[]
  poolPayments  PoolPayment[]
}

model StokvelMember {
  id            String   @id @default(cuid())
  stokvelId     String
  stokvel       Stokvel  @relation(fields: [stokvelId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  referenceCode String
  subAccountRef String?
  joinedAt      DateTime @default(now())

  @@unique([stokvelId, userId])
  @@unique([stokvelId, referenceCode])
}

model StokvelOfficial {
  id        String       @id @default(cuid())
  stokvelId String
  stokvel   Stokvel      @relation(fields: [stokvelId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  role      OfficialRole
  createdAt DateTime     @default(now())

  approvals PayoutApproval[]
  poolFundingApprovals StokvelPoolFundingApproval[]

  @@unique([stokvelId, userId])
}

model Contribution {
  id           String             @id @default(cuid())
  stokvelId    String
  stokvel      Stokvel            @relation(fields: [stokvelId], references: [id])
  memberId     String
  amount       Decimal
  status       ContributionStatus @default(PENDING)
  cycleNumber  Int?
  rawBankLogId String?
  rawBankLog   RawBankLog?        @relation(fields: [rawBankLogId], references: [id])
  note         String?
  createdAt    DateTime           @default(now())
}

model Payout {
  id           String            @id @default(cuid())
  stokvelId    String
  stokvel      Stokvel           @relation(fields: [stokvelId], references: [id])
  recipientId  String
  amount       Decimal
  status       TransactionStatus @default(PENDING_APPROVAL)
  cycleNumber  Int?
  rawBankLogId String?
  rawBankLog   RawBankLog?       @relation(fields: [rawBankLogId], references: [id])
  createdAt    DateTime          @default(now())
  clearedAt    DateTime?
  // Whether the recipient chose, at request time, to contribute a suggested
  // share of this payout to Ubuhlanti bakwa Xhosa — always opt-in, never a
  // forced deduction.
  contributionOptIn Boolean @default(false)

  approvals PayoutApproval[]
  contribution ShrineContribution?
}

model PayoutApproval {
  id         String          @id @default(cuid())
  payoutId   String
  payout     Payout          @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  officialId String
  official   StokvelOfficial @relation(fields: [officialId], references: [id])
  approvedAt DateTime        @default(now())

  @@unique([payoutId, officialId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "PAYOUT_APPROVAL_NEEDED" | "POOL_CHANGED" | "CONTRIBUTION_CONFIRMED" | "QUOTE_STATUS" | "ORDER_MATCHED"
  message     String
  linkScreen  String?  // which screen to navigate to on tap, e.g. "stokvels"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Ubuhlanti bakwa Xhosa — the sovereign Xhosa cultural wealth & development
// fund. A contribution here is always voluntary: either a stokvel member's
// opt-in share of their own cleared payout, or a direct public donation.
// Kept on the existing physical "ShrineTithe" table (no data migration
// needed) — only the model name and vocabulary moved away from "tithe".
model ShrineContribution {
  id       String  @id @default(cuid())
  payoutId String? @unique
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  amount   Decimal
  // 'PAYOUT_CONTRIBUTION' (opt-in share of a cleared stokvel payout) or
  // 'PUBLIC_DONATION' (anyone, R1 and up, via the Donate flow).
  source String @default("PAYOUT_CONTRIBUTION")
  // Only ever set for PUBLIC_DONATION — optional, the donor may stay anonymous.
  donorName  String?
  donorEmail String?
  // Payout contributions are confirmed the moment the payout clears (real
  // internal ledger entry, no separate payment step). Public donations start
  // PENDING until a real person follows up and confirms the actual transfer
  // — there is no live payment gateway or bank details on file yet.
  status    String   @default("CONFIRMED")
  // 'CONTRIBUTION' (money into the fund) or 'ALLOCATION' (money committed
  // out of it to a real project). Both live on this one ledger so the fund
  // has a single source of truth rather than a second, forkable table.
  entryType String @default("CONTRIBUTION")
  // ALLOCATION rows only: which development sector the money went to, what
  // it was for, and a link to the receipt/title/grant document backing it.
  // Left null on contributions.
  sector       String?
  description  String?
  referenceUrl String?
  createdAt DateTime @default(now())

  @@map("ShrineTithe")
}

// ---------- BANK RECONCILIATION LAYERS ----------

model RawBankLog {
  id              String   @id @default(cuid())
  stokvelId       String
  stokvel         Stokvel  @relation(fields: [stokvelId], references: [id])
  rawPayload      Json
  narration       String?
  amount          Decimal
  direction       String
  matchedMemberId String?
  receivedAt      DateTime @default(now())

  contributions Contribution[]
  payouts       Payout[]
}

model StokvelGroupLedger {
  id             String   @id @default(cuid())
  stokvelId      String   @unique
  stokvel        Stokvel  @relation(fields: [stokvelId], references: [id])
  totalBalance   Decimal
  interestEarned Decimal  @default(0)
  groupExpenses  Decimal  @default(0)
  updatedAt      DateTime @updatedAt
}

// ---------- BASKET / MATCHING ----------

model Basket {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  stokvelId    String?
  stokvel      Stokvel?      @relation(fields: [stokvelId], references: [id], onDelete: SetNull)
  status       BasketStatus  @default(DRAFT)
  ceremonyType CeremonyType?
  ceremonyId   String?
  ceremony     Ceremony?     @relation(fields: [ceremonyId], references: [id], onDelete: SetNull)
  checklistItemId String?
  checklistItem CeremonyChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  ceremonyCostItemId String?
  ceremonyCostItem CeremonyCostItem? @relation(fields: [ceremonyCostItemId], references: [id], onDelete: SetNull)
  fundingSource String @default("PERSONAL")
  fundingStokvelId String?
  fundingStokvel Stokvel? @relation("BasketFundingStokvel", fields: [fundingStokvelId], references: [id], onDelete: SetNull)
  poolId       String?
  pool         BulkPool?     @relation(fields: [poolId], references: [id])
  // System-generated, globally unique — set once this basket's pool matches
  // (server/utils/referenceGenerator.js). Identifies this one cart's
  // contribution to the pool, e.g. so 6 pallets can be split up and labelled
  // by whose order is whose at collection/delivery time. Reused as-is for
  // this basket's PoolPayment.paymentReference, since it's the same cart on
  // both sides — one code a member both pays against and is handed goods
  // against. Null until matched.
  orderReference String?     @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items BasketItem[]
  fundingRequests StokvelPoolFunding[]

  @@index([ceremonyId])
}

model BasketItem {
  id       String @id @default(cuid())
  basketId String
  basket   Basket @relation(fields: [basketId], references: [id])
  skuId    String
  sku      Sku    @relation(fields: [skuId], references: [id])
  quantity Int
}

model Sku {
  id                String   @id @default(cuid())
  name              String
  category          String
  productType       String
  bottleFormat      String?
  unitsPerCase      Int
  // What a member pays iCamagu per bulk unit. Nullable on purpose: a row can
  // exist — name, pack format, category all real — before anyone has been to
  // Makro/Food Lover's to price it. Null here means "catalogued, not yet
  // orderable" everywhere downstream (Store hides the Add button, the basket
  // endpoint refuses to add it) — the same discipline retailPriceZAR already
  // applies to an unverified shop price, just one step earlier: no invented
  // member price ever reaches a screen.
  casePriceZAR      Decimal? @db.Decimal(10, 2)
  palletPackQty     Int?
  palletPriceZAR    Decimal? @db.Decimal(10, 2)
  supplierPortfolio String?
  imageUrl          String?
  retailPriceZAR    Decimal? @db.Decimal(10, 2)
  // What iCamagu actually pays a supplier for one case. Admin-only — never
  // returned by the public catalogue endpoint. Without it the app cannot
  // report a margin, and nothing stops a price being listed below cost,
  // which is exactly how Hennessy came to sit R22 under its own cost.
  costPriceZAR      Decimal? @db.Decimal(10, 2)
  // What a single buying unit of this product is actually called. Only
  // alcohol and tinned goods come in "cases" — onions come in pockets,
  // maize meal in bags, live animals are counted per head. Defaults keep
  // the old wording for anything not yet classified.
  bulkUnit          String   @default("case")
  bulkUnitPlural    String   @default("cases")
  // Where retailPriceZAR came from. VERIFIED means somebody read it off a
  // shelf or a retailer's own page and wrote down where and when. ESTIMATE
  // means it was modelled — useful for margin work, never shown to a member
  // as a saving. Null alongside a null price. The public catalogue withholds
  // the price entirely unless this says VERIFIED, so a savings claim cannot
  // be built on a number nobody checked.
  retailPriceSource    String?
  retailPriceCheckedAt DateTime?
  retailPriceNote      String?
  createdAt         DateTime @default(now())

  basketItems BasketItem[]
  costItems   CeremonyCostItem[]

  @@unique([name, bottleFormat])
}

model BulkPool {
  id        String    @id @default(cuid())
  // Which real-world category this pool is for (alcohol/meat/groceries/
  // produce) — always set at creation, independent of whether a real
  // confirmed supplier exists yet. Pool formation and joining must never
  // depend on a Partner row existing (founder's explicit call): a partner
  // gets attached automatically once one matches, or manually once a real
  // deal is signed, but the pool itself works — collects members, tracks
  // MOQ progress — with or without one.
  category  PartnerType
  partnerId String?
  partner   Partner?  @relation(fields: [partnerId], references: [id])
  area      String
  latitude  Float?
  longitude Float?
  radiusKm  Float     @default(20)
  createdById String?
  createdBy User?     @relation("BulkPoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deadline  DateTime?
  moqTarget Int
  status    String    @default("OPEN")
  createdAt DateTime  @default(now())
  // Highest SmartMatch tier id (see tierBasis/tierLadder below) already
  // emailed to admin for this pool — prevents re-notifying on every basket
  // submission once a tier is hit. 0 = none yet.
  lastTierNotified Int @default(0)
  // Rolling-window demand cap: once a pool's real case count reaches this,
  // it stops accepting new baskets — further signups open a fresh pool
  // instead of piling onto one unbounded batch. Set from moqTarget at
  // creation time (see poolWindow.js); null on pools created before this
  // existed, which stay uncapped rather than being retroactively closed.
  capCases Int?

  // How this pool's SmartMatch tiers are measured. Alcohol comes in
  // pallets; groceries and livestock mostly don't — a produce or livestock
  // wholesaler is more likely to discount off total Rand spent than off a
  // pallet count, so a pool needs to say which applies to it.
  //   PALLETS — tier minimums are in pallets (see smartMatchTiers.js;
  //             1 pallet = 56 cases), tier value is a case price.
  //   AMOUNT  — tier minimums are Rand pooled, tier value is a % off.
  tierBasis String @default("PALLETS")

  // The pool's real, negotiated tier ladder: [{ id, name, min, value }, ...].
  // `min` is in pallets or Rand depending on tierBasis; `value` is a case
  // price (PALLETS) or a discount percentage (AMOUNT) — null until a real
  // wholesaler quote exists for that tier. Left null entirely until the
  // founder sets one up: a PALLETS pool then falls back to the standard
  // alcohol bands (see DEFAULT_PALLET_TIERS) with every value unset, so the
  // shape is visible immediately; an AMOUNT pool has no such universal
  // default — every wholesaler negotiates its own spend bands — so it shows
  // nothing until a real ladder is entered. Never a placeholder or guessed
  // figure, exactly like Sku.retailPriceZAR staying null rather than guessed.
  tierLadder Json?

  baskets       Basket[]
  payments      PoolPayment[]
  fundingRequests StokvelPoolFunding[]
  orderDocument OrderConfirmationDocument?

  @@index([category, status])
}

// Requests to spend a stokvel's funds on a SmartMatch pool order.
// Money must not move until the configured number of distinct officials approve.
model StokvelPoolFunding {
  id            String   @id @default(cuid())
  stokvelId     String
  stokvel       Stokvel  @relation(fields: [stokvelId], references: [id])
  poolId        String
  pool          BulkPool @relation(fields: [poolId], references: [id])
  basketId      String?
  basket        Basket?  @relation(fields: [basketId], references: [id], onDelete: SetNull)
  requestedById String
  requestedBy   User     @relation("StokvelPoolFundingRequester", fields: [requestedById], references: [id])
  amountZAR     Decimal  @db.Decimal(10, 2)
  purpose       String?
  status        String   @default("PENDING_APPROVAL")
  requiredApprovals Int  @default(2)
  approvedAt    DateTime?
  declinedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approvals StokvelPoolFundingApproval[]
  payments  PoolPayment[]

  @@index([stokvelId, status, createdAt])
  @@index([poolId, status])
}

model StokvelPoolFundingApproval {
  id          String   @id @default(cuid())
  fundingId   String
  funding     StokvelPoolFunding @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  officialId  String
  official    StokvelOfficial @relation(fields: [officialId], references: [id])
  approverId  String
  approver    User @relation("StokvelPoolFundingApprover", fields: [approverId], references: [id])
  decision    String
  note        String?
  decidedAt   DateTime @default(now())

  @@unique([fundingId, officialId])
  @@index([approverId, decidedAt])
}

// ---------- ORDER CONFIRMATION & SAFE DELIVERY ----------

model PoolPayment {
  id                String   @id @default(cuid())
  poolId            String
  pool              BulkPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  stokvelId         String?
  stokvel           Stokvel? @relation(fields: [stokvelId], references: [id], onDelete: SetNull)
  fundingRequestId  String?
  fundingRequest    StokvelPoolFunding? @relation(fields: [fundingRequestId], references: [id], onDelete: SetNull)
  provider          String
  providerReference String?
  // System-generated, globally unique — see server/utils/referenceGenerator.js.
  // What THIS member is actually told to use as their EFT reference, distinct
  // from the pool's shared BulkPool.orderDocument.groupCode (which identifies
  // the order as a whole, not any one person's payment). Without a reference
  // per payment, every member in the same matched pool would be told to use
  // the same code, and a supplier reviewing their bank statement would have
  // no way to tell whose transfer was whose. Null only for payments created
  // before this field existed.
  paymentReference  String?  @unique
  amountZAR         Decimal  @db.Decimal(10, 2)
  status            String   @default("PENDING")
  refundRequestedAt DateTime?
  refundFeeZAR      Decimal? @db.Decimal(10, 2)
  // Set only when an admin processes a refund on a PSP-collected payment —
  // the supplier never held that money (see processRefund in
  // supplierService.js), so unlike a manual-EFT refund there's no
  // supplier-side action to record; this is the admin's own note on how the
  // money actually got back to the member (bank transfer reference, etc).
  // Null for every manual-EFT refund, which the supplier processes directly.
  refundNote        String?
  // The PSP's raw webhook payload for this payment, kept verbatim for
  // reconciliation/debugging — same pattern as RawBankLog.rawPayload for
  // manual EFT. Null for manual-EFT payments, which have no webhook.
  rawPayload Json?
  // When the PSP itself confirmed settlement (money actually moved) —
  // distinct from updatedAt, which changes on any edit. Null until a real
  // PSP adapter exists; a manual-EFT payment is "settled" when an official
  // marks it CLEARED, which this field doesn't need to track.
  settledAt  DateTime?
  // A PSP-collected payment (provider e.g. 'PAYFAST') lands in iCamagu's own
  // merchant account, not the supplier's — unlike manual EFT, where the
  // member pays the supplier directly and CLEARED already means the
  // supplier has the money. Until a real payout API exists (Stitch/Ozow/
  // PayFast payouts — a real business relationship, not yet in place),
  // forwarding that money to the supplier is a manual bank transfer an
  // admin does by hand and records here. Null and irrelevant for
  // manual-EFT payments, where no such forwarding step exists.
  payoutForwardedAt DateTime?
  payoutReference   String?
  payoutNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([poolId, status])
  @@index([userId, createdAt])
  @@index([stokvelId, createdAt])
}

model OrderConfirmationDocument {
  id               String    @id @default(cuid())
  poolId           String    @unique
  pool             BulkPool  @relation(fields: [poolId], references: [id])
  groupCode        String    @unique
  totalAmountZAR   Decimal   @db.Decimal(10, 2)
  deliveryLocation String
  deliveryDate     DateTime?
  status           String    @default("PENDING_MEMBER_CONFIRMATION")
  createdAt        DateTime  @default(now())

  lineItems OrderLineConfirmation[]
}

model OrderLineConfirmation {
  id              String                    @id @default(cuid())
  documentId      String
  document        OrderConfirmationDocument @relation(fields: [documentId], references: [id])
  memberId        String
  // The matching Basket.orderReference — carried directly on each line item
  // (not just memberId) so a supplier splitting a pool's physical stock can
  // read the reference straight off the packing list, no lookup needed.
  // Shared by every line item from the same cart, so never unique here.
  orderReference  String?
  itemDescription String
  quantity        Int
  unitType        String
  confirmedAt     DateTime?
}

model Partner {
  id        String      @id @default(cuid())
  userId    String?     @unique
  user      User?       @relation(fields: [userId], references: [id])
  name      String
  type      PartnerType
  area      String
  latitude  Float?
  longitude Float?
  moq       Int?
  createdAt DateTime    @default(now())

  // Settlement destination for a PSP-routed pool payout (Stitch/Ozow-style
  // same-day pass-through). Null until a real banking relationship exists
  // for this partner — a pool works with no Partner at all (see BulkPool),
  // and a Partner works with no bank details yet, same "never block on the
  // next layer" principle applied one level further down.
  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankBranchCode    String?

  pools BulkPool[]
}

